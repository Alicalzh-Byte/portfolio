---
/**
 * 文章详情（PRD §3.2 / F4）。
 * 正文与目录都来自 packages/shared 的同一套渲染管线 —— 后台预览与线上渲染因此逐字符一致（AC4.4）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import PostItem from '../../components/PostItem.astro';
import { renderMarkdown, extractHeadings } from '@portfolio/shared/markdown';
import { loadPostDetail, loadSiteContext } from '../../lib/server/content';
import { formatDate, mediaUrl, nameInitial } from '../../lib/format';

const { slug } = Astro.params;
const { settings, profile } = await loadSiteContext();
const detail = slug ? await loadPostDetail(slug) : null;

// 草稿在数据层已被过滤 → 这里拿到 null → 走 404（草稿永远不会被公开访问到）
if (!detail) {
  return Astro.rewrite('/404');
}

const { post, related } = detail;
const contentHtml = await renderMarkdown(post.contentMd);
const toc = extractHeadings(post.contentMd);
const coverUrl = mediaUrl(post.coverKey);
const avatarUrl = mediaUrl(profile?.avatarKey);

// 目录取二三级标题即可，层次太深反而失去导航价值
const visibleToc = toc.filter((item) => item.depth === 2 || item.depth === 3);
---

<BaseLayout
  title={post.title}
  description={post.summary ?? ''}
  currentPath="/blog"
  settings={settings}
  profile={profile}
  dimStars
>
  <article class="container">
    <header class="page-head">
      {post.tags.length > 0 && (
        <div class="tag-row" style="margin-bottom: var(--space-3)">
          {post.tags.map((tag) => <TagPill tag={tag} href={`/tags/${tag.slug}`} />)}
        </div>
      )}

      <h1 class="page-head__title">{post.title}</h1>

      <p class="post-item__meta" style="margin-top: var(--space-4)">
        <time class="tabular" datetime={post.publishedAt ?? post.createdAt}>
          {formatDate(post.publishedAt ?? post.createdAt)}
        </time>
        <span aria-hidden="true">·</span>
        <span>约 {post.readingMinutes} 分钟</span>
      </p>
    </header>

    <div class="article-grid">
      <div>
        {
          coverUrl && (
            <img
              class="article-cover"
              src={coverUrl}
              alt={`${post.title} 的封面`}
              width="1120"
              height="630"
              decoding="async"
            />
          )
        }

        {/* 渲染产物已通过 rehype-sanitize 消毒（script / on* / javascript: 均被剔除） */}
        <div class="prose" set:html={contentHtml} />

        {
          profile && (
            <aside class="author-card">
              <div class="author-card__avatar" aria-hidden="true">
                {avatarUrl ? (
                  <img src={avatarUrl} alt="" width="48" height="48" />
                ) : (
                  nameInitial(profile.displayName)
                )}
              </div>
              <div>
                <p class="author-card__name">{profile.displayName}</p>
                {profile.headline && <p class="author-card__bio">{profile.headline}</p>}
              </div>
            </aside>
          )
        }
      </div>

      {
        visibleToc.length > 0 && (
          // 目录在移动端排在正文之后（见下方样式），避免小块先占满首屏
          <nav class="toc" aria-labelledby="toc-heading">
            <p class="toc__title" id="toc-heading">本文目录</p>
            <div class="toc__list">
              {visibleToc.map((item) => (
                <a class={`toc__link toc__item--${item.depth}`} href={`#${item.id}`}>
                  {item.text}
                </a>
              ))}
            </div>
          </nav>
        )
      }
    </div>

    {
      related.length > 0 && (
        <section class="section section--tight" aria-labelledby="related-heading">
          <h2 class="section-heading__title" id="related-heading">
            相关文章
          </h2>
          <div class="post-list">
            {related.map((item) => (
              <PostItem post={item} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .article-grid {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: minmax(0, 1fr) 240px;
      align-items: start;
    }
  }

  .article-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    margin-bottom: var(--space-7);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .author-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--measure);
    margin-top: var(--space-8);
    padding: var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-elev-1);
  }

  .author-card__avatar {
    display: grid;
    width: 48px;
    height: 48px;
    flex: none;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--bg-elev-2);
    color: var(--text-secondary);
    font-weight: 650;
  }

  .author-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .author-card__name {
    font-weight: 650;
  }

  .author-card__bio {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
</style>
