---
/**
 * 后台登录页（自建密码登录）。
 * Cloudflare Access 未配置时的兜底入口：输入密码后跳回 /admin/。
 */
export const prerender = false;

const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') ?? '/admin/';
const message =
  error === '1' ? '密码不正确，请重试。' : error === 'config' ? '后台未配置密码登录。' : '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>后台登录</title>
    <style>
      :root {
        color-scheme: dark;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
      }
      body {
        margin: 0;
        display: grid;
        place-items: center;
        background: radial-gradient(circle at 20% 20%, #1a2246 0%, #0a0b14 45%, #06070d 100%);
        color: #eceef7;
        font-family: system-ui, -apple-system, 'Segoe UI', 'Microsoft YaHei', sans-serif;
      }
      .card {
        width: min(92vw, 380px);
        padding: 32px 28px;
        border-radius: 16px;
        background: rgba(17, 20, 36, 0.86);
        border: 1px solid rgba(140, 160, 255, 0.18);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
      }
      h1 {
        margin: 0 0 6px;
        font-size: 22px;
        letter-spacing: 0.04em;
      }
      p {
        margin: 0 0 22px;
        color: #a6abc2;
        font-size: 14px;
        line-height: 1.6;
      }
      label {
        display: block;
        margin-bottom: 8px;
        font-size: 13px;
        color: #c7cbe0;
      }
      input {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid rgba(140, 160, 255, 0.25);
        background: rgba(8, 10, 20, 0.8);
        color: #eceef7;
        font-size: 15px;
        outline: none;
      }
      input:focus {
        border-color: #6c8cff;
        box-shadow: 0 0 0 3px rgba(108, 140, 255, 0.18);
      }
      button {
        width: 100%;
        margin-top: 18px;
        padding: 12px 14px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #6c8cff, #8f6cff);
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover {
        filter: brightness(1.06);
      }
      .error {
        margin: 0 0 16px;
        padding: 10px 12px;
        border-radius: 8px;
        background: rgba(255, 99, 99, 0.12);
        border: 1px solid rgba(255, 99, 99, 0.28);
        color: #ff9a9a;
        font-size: 13px;
      }
      .tip {
        margin: 18px 0 0;
        font-size: 12px;
        color: #7d849e;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <h1>后台登录</h1>
      <p>输入管理密码后进入后台。会话有效期 12 小时。</p>
      {message && <div class="error">{message}</div>}
      <form method="post" action="/api/login">
        <input type="hidden" name="next" value={next} />
        <label for="password">管理密码</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          placeholder="请输入密码"
          required
          autofocus
        />
        <button type="submit">登录</button>
      </form>
      <p class="tip">此页面仅站点所有者使用，不对外公开。</p>
    </main>
  </body>
</html>
