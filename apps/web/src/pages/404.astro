---
/** 404 页。noindex，且不提供任何数据。 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import { loadSiteContext } from '../lib/server/content';

const { settings, profile } = await loadSiteContext();
---

<BaseLayout title="页面不存在" currentPath="/404" settings={settings} profile={profile} noIndex>
  <div class="container">
    <div class="page-head">
      <h1 class="page-head__title">404</h1>
      <p class="page-head__lead">这个页面不存在，或者内容已经被撤下。</p>
    </div>

    <EmptyState
      title="找不到你要的内容"
      text="可以回到首页，或者去看看项目与文章列表。"
      actionHref="/"
      actionLabel="返回首页"
    />
  </div>
</BaseLayout>
